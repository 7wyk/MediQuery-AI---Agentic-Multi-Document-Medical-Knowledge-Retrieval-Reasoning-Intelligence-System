# =============================================================================
# MediQuery AI - backend environment template
# Copy to backend/.env and fill in real values. NEVER commit the real .env.
# =============================================================================

# --- Runtime -----------------------------------------------------------------
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO

# --- Database ----------------------------------------------------------------
# Local development may use SQLite; production MUST be Supabase PostgreSQL.
# Use the Supabase "Session pooler" connection string.
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./mediquery_dev.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# --- Supabase (database + private object storage) ----------------------------
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=mediquery-documents
STORAGE_BACKEND=supabase
STORAGE_LOCAL_DIR=./local_storage
SIGNED_URL_EXPIRES_SECONDS=3600

# --- Authentication ----------------------------------------------------------
# Minimum 32 random characters in production. Generate with:
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-at-least-32-characters
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- HTTP / CORS -------------------------------------------------------------
CORS_ORIGINS=http://localhost:5173,https://your-frontend.vercel.app
RATE_LIMIT_PER_MINUTE=90
RATE_LIMIT_UPLOAD_PER_MINUTE=12

# --- Ingestion limits --------------------------------------------------------
MAX_UPLOAD_MB=25
MAX_FILES_PER_REQUEST=5
MAX_DOCUMENT_PAGES=400
MAX_CHUNKS_PER_DOCUMENT=4000
MAX_IMAGE_ANALYSIS_PER_DOCUMENT=15
MAX_OCR_PAGES=25
ENABLE_IMAGE_ANALYSIS=true
CHUNK_SIZE=900
CHUNK_OVERLAP=120

# --- Hosted AI providers (no local models) -----------------------------------
# Embeddings: gemini | openai | jina
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32
GEMINI_API_KEY=replace-with-gemini-api-key
GEMINI_BASE_URL=https://generativelanguage.googleapis.com
JINA_API_KEY=replace-with-jina-api-key
JINA_BASE_URL=https://api.jina.ai/v1
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_BASE_URL=https://api.openai.com/v1

# Generation: groq | gemini | openai
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
GROQ_API_KEY=replace-with-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1400
LLM_TIMEOUT_SECONDS=60
# Structured (JSON) calls: reasoning models spend completion tokens on reasoning
# before emitting the JSON document, so this budget must be larger than the output.
LLM_JSON_MAX_TOKENS=1600
# low | medium | high - applied only to gpt-oss reasoning models on Groq.
LLM_REASONING_EFFORT=low

# Reranking: jina | cohere | lexical | none
# "lexical" is a deterministic scoring fallback (no model, no network).
RERANK_PROVIDER=jina
RERANK_MODEL=jina-reranker-v2-base-multilingual
COHERE_API_KEY=replace-with-cohere-api-key
COHERE_BASE_URL=https://api.cohere.com
RERANK_TOP_N=8
MIN_RERANK_SCORE=0.15
# Fraction of a question's aspects that must have direct evidence support.
# 1.0 = every part required; 0.5 = answer supported parts and declare the rest.
EVIDENCE_MIN_COVERAGE=0.5

# OCR / vision for scanned documents and charts: gemini | ocrspace | none
OCR_PROVIDER=gemini
OCRSPACE_API_KEY=replace-with-ocrspace-api-key
OCRSPACE_BASE_URL=https://api.ocr.space
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.6-flash

AI_REQUEST_TIMEOUT_SECONDS=60
AI_MAX_RETRIES=2

# --- Retrieval & agentic RAG --------------------------------------------------
RETRIEVAL_TOP_K=6
RETRIEVAL_CANDIDATES=30
KEYWORD_CANDIDATES=30
RRF_K=60
AGENT_MAX_ATTEMPTS=2
ENABLE_QUERY_TRANSFORM=true
MAX_SUBQUERIES=3
ENABLE_CLAIM_VERIFICATION=true
MEDICAL_DOMAIN_LLM_CHECK=true
MEDICAL_DOMAIN_THRESHOLD=0.3

# --- Trusted medical web fallback --------------------------------------------
WEB_SEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=europepmc
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_TIMEOUT_SECONDS=15
WEB_SEARCH_ALLOWED_DOMAINS=europepmc.org,pubmed.ncbi.nlm.nih.gov,ncbi.nlm.nih.gov,nih.gov,who.int,cdc.gov

# --- Graph RAG ----------------------------------------------------------------
ENABLE_GRAPH_RAG=true
GRAPH_MAX_HOPS=2
GRAPH_MAX_ENTITIES=40

# --- Background processing ----------------------------------------------------
BACKGROUND_WORKER_ENABLED=true
JOB_POLL_INTERVAL_SECONDS=2
JOB_MAX_ATTEMPTS=3
WORKER_CONCURRENCY=2
JOB_STALE_SECONDS=900
# Used by the external job trigger endpoint (/api/v1/internal/jobs/run)
WORKER_TOKEN=

# --- Observability & cost (rates are provider-specific; 0 = free tier) --------
COST_LLM_INPUT_PER_1M=0
COST_LLM_OUTPUT_PER_1M=0
COST_EMBEDDING_PER_1M=0
COST_RERANK_PER_1K=0
EVALUATION_ENABLED=false