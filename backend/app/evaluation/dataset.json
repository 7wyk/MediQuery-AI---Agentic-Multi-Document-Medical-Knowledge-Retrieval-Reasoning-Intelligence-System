{
  "version": 1,
  "description": "Reproducible medical RAG evaluation set for the demo documents in /demo. Upload Diabetes_Management.pdf, Hypertension_Guidelines.pdf, Common_Medications_Guide.pdf, First_Aid_Procedures.pdf and Mental_Health_Resources.pdf before running the evaluation.",
  "cases": [
    {
      "id": "fact-001",
      "category": "simple_factual",
      "question": "What are the common symptoms of diabetes?",
      "expected_filenames": ["Diabetes_Management.pdf"],
      "expected_keywords": ["thirst", "urination", "fatigue", "weight"],
      "should_abstain": false
    },
    {
      "id": "fact-002",
      "category": "simple_factual",
      "question": "What is the normal blood pressure range?",
